# --- Environment ---------------------------------------------------------
# Copy to .env and fill in the real values. .env is gitignored.
# Never commit a real value here.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/appname
DATABASE_SSL=false

# --- Authentication ------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# --- External services ---------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# --- Observability -------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
